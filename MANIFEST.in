include LICENSE CITATION.cff CHANGELOG.md THIRD_PARTY_NOTICES.md CONTRIBUTING.md
include .gitignore .gitattributes
recursive-include src *.py *.typed *.cpp *.cu *.cuh *.hpp *.h
recursive-include examples *.py
recursive-include docs *.md
recursive-include tests *.py
recursive-include tools *.py
recursive-include .github *.yml *.md
global-exclude __pycache__ *.py[cod] *.so *.pyd *.dll *.obj *.o
